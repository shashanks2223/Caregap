# ==============================================================================
# CareGap AI – Environment Configuration Template
# ==============================================================================

# Application Environment
APP_NAME="CareGap AI"
APP_ENV=development
DEBUG=True

# Database Configuration (PostgreSQL for Docker/Production, SQLite for Zero-Config Local Dev)
DATABASE_URL=sqlite:///./caregap.db
# DATABASE_URL=postgresql+psycopg2://caregap_user:caregap_secret_2026@localhost:5432/caregap_db

# Security & Authentication (Generate using: openssl rand -hex 32)
JWT_SECRET_KEY=caregap-super-secret-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini API (Get key from https://aistudio.google.com/)
# If empty, CareGap AI automatically uses an intelligent deterministic heuristic fallback!
GEMINI_API_KEY=

# Frontend & CORS URLs
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://localhost:8000"]

# Demo Credentials
DEMO_PASSWORD=CareGap@2026!

